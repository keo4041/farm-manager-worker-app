rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Fetch authenticated user's profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user belongs to the specified tenant
    function isTenantMember(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    // Helper function: Check if user is an Owner or Admin for the tenant
    function isOwnerOrAdmin(tenantId) {
      return isTenantMember(tenantId) && (getUserData().role == 'owner' || getUserData().role == 'admin');
    }

    // =========================================================================
    // 1. Farm Codes Public Directory (Minimal metadata for login lookup only)
    // Document ID is the uppercase Farm Code (e.g. /farm-codes/AGBE4821)
    // Contains ONLY: { farmCode, tenantId, name }
    // =========================================================================
    match /farm-codes/{code} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.tenantId);
    }

    // =========================================================================
    // 2. Tenants Collection (Full sensitive profile, license, config)
    // =========================================================================
    match /tenants/{tenantId} {
      // Strictly restricted to authenticated tenant members
      allow read: if isTenantMember(tenantId);
      allow create: if isAuthenticated();
      allow update, delete: if isOwnerOrAdmin(tenantId);
    }

    // =========================================================================
    // 3. Users Collection
    // =========================================================================
    match /users/{userId} {
      // User can read their own profile, or members of the same tenant can read team profiles
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        getUserData().tenantId == resource.data.tenantId
      );
      // Authenticated users creating their own profile, or Admin creating team member
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isOwnerOrAdmin(request.resource.data.tenantId)
      );
      // User can update own non-sensitive profile (e.g. displayName), but CANNOT self-escalate role or change tenantId
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == userId && 
          request.resource.data.role == resource.data.role && 
          request.resource.data.tenantId == resource.data.tenantId
        ) || 
        isOwnerOrAdmin(resource.data.tenantId)
      );
      // Owner/Admin can delete tenant users
      allow delete: if isOwnerOrAdmin(resource.data.tenantId);
    }

    // =========================================================================
    // 4. Agbelouve Farm Daily Logs Collection
    // =========================================================================
    match /agbelouve-farm-daily-logs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isTenantMember(resource.data.tenantId)
      );
      allow create: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow update: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow delete: if isOwnerOrAdmin(resource.data.tenantId);
    }
  }
}
